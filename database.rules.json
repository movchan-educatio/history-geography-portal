{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
    "submissions": { "$id": { ".write": "auth != null && (!data.exists() ? newData.child('studentUid').val() === auth.uid : (data.child('studentUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'teacher'))" } },
    "grades": { "$id": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'" } },
    "lessons": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'" },
    "assignments": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'" }
  }
}
